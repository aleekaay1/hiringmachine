<?xml version="1.0"?>
<!--
  PAZ Hiring — 3CX CRM template (ping only — Version 4)
  Recordings are NOT pushed via webhook. HR loads them on-demand from Call log (3CX API).

  Upload: Settings → CRM → + Add Template → PAZ Hiring Call Log → Save
  Optional: remove/disable old templates that had ReportCall to stop irrelevant call traffic.
-->
<Crm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Country="CA" Name="PAZ Hiring Call Log" Version="4" SupportsEmojis="false">
  <Number Prefix="AsIs" />
  <Connection MaxConcurrentRequests="4" />
  <Authentication Type="No" />
  <Scenarios>
    <Scenario Type="REST">
      <Request Url="https://hlfufjrjztuknioydlut.supabase.co/functions/v1/threecx-call-webhook?ping=1" RequestType="Get" ResponseType="Json" MessagePasses="0" Message="" />
      <Rules>
        <Rule Type="Any">ok</Rule>
      </Rules>
      <Variables />
      <Outputs AllowEmpty="true" />
    </Scenario>
  </Scenarios>
</Crm>
