{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v/:file.vcf",
      "destination": "/api/vcard"
    },
    {
      "source": "/((?!assets/|models/|onnxruntime-web/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
